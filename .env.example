# Castellan environment. Every variable the code reads is listed here; nothing
# else is used. Secrets go in your host's encrypted environment settings, never
# in this file or the repository.

# --- Database (required in production) ---------------------------------------
# Hosted Postgres, UK/EU region. Supabase: use the transaction pooler URI (port
# 6543). Percent-encode special characters in the password (# -> %23).
# Any one of these names is accepted; DATABASE_URL takes precedence.
DATABASE_URL=""
# POSTGRES_URL / POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING  (alternatives)

# Role the request path drops to on every transaction so row-level security
# applies. Created by the bootstrap; keep this exact value in production.
DB_LOCAL_ROLE="app_user"

# Protects POST /api/bootstrap, which applies migrations and RLS. Use a long
# random value (e.g. `openssl rand -hex 24`). Without it the route returns 404.
BOOTSTRAP_TOKEN=""

# --- Public URL (required in production) --------------------------------------
# Base for links in emails. Never derived from the request (prevents
# password-reset link poisoning). Falls back to Vercel's production domain.
APP_URL="https://castellanhere.vercel.app"

# --- Email (required in production for sign-up, reset and invites) -----------
# Resend API key. Without it, production refuses to send (and records the
# failure); development captures mail at /dev/mailbox instead.
RESEND_API_KEY=""
# Sender. Must be on a domain verified in Resend. The default shared sender
# (onboarding@resend.dev) can only deliver to your own Resend account address.
EMAIL_FROM="Castellan <no-reply@your-verified-domain.example>"

# --- Optional -----------------------------------------------------------------
# Enables the conversational assistant for signed-in users. Without it the
# assistant answers deterministically from data.
ANTHROPIC_API_KEY=""
CASTELLAN_CHAT_MODEL=""

# Local development only.
CASTELLAN_DEV_DB_DIR=""       # where the file-backed dev database lives
CASTELLAN_LIVE_CLOCK=""       # use the real date instead of the demo's fixed date
