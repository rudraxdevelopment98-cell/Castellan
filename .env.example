# Castellan environment (Phase 1 demo runs entirely on in-memory seed data —
# none of these are required to run `npm run dev`). They document the
# production wiring described in tech_stack_recommendation.

# --- Data residency: UK region only (security_and_privacy) ---
DATABASE_URL="postgres://user:pass@host:5432/castellan"   # Neon/Supabase eu-west-2
DATA_REGION="eu-west-2"

# --- Object storage (encrypted, UK region) for original documents ---
S3_ENDPOINT=""
S3_BUCKET="castellan-documents"
S3_REGION="eu-west-2"

# --- Document AI (vision LLM, JSON-schema extraction; must not train on data) ---
LLM_API_KEY=""
LLM_CLASSIFY_MODEL="claude-haiku-4-5"     # cheap classifier
LLM_EXTRACT_MODEL="claude-opus-4-8"       # strong extractor for complex docs
EXTRACTION_CONFIDENCE_THRESHOLD="0.9"     # admin-editable; below this => human review

# --- Notifications ---
RESEND_API_KEY=""                          # or POSTMARK_API_KEY
TWILIO_ACCOUNT_SID=""                      # WhatsApp Business
TWILIO_AUTH_TOKEN=""
WEB_PUSH_VAPID_PUBLIC=""
WEB_PUSH_VAPID_PRIVATE=""

# --- Open Banking (read-only transaction matching) ---
OPEN_BANKING_CLIENT_ID=""
OPEN_BANKING_CLIENT_SECRET=""

# --- Auth / MFA ---
AUTH_SECRET=""
